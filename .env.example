# Placeholder-only Staging template. Never commit populated copies.
# Copy to .env.local (ignored). Configure Staging hosting only; not Production.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<staging-publishable-key>

# Server only. Select the Connect panel's session-pooler or direct connection.
# Use verified TLS and the provider CA; never rejectUnauthorized=false.
DATABASE_URL=postgresql://<staging-db-user>:<url-encoded-password>@<staging-db-host>:5432/postgres?sslmode=verify-full&sslrootcert=<staging-ca-file-path>
AUTH_ISSUER_URL=https://<staging-project-ref>.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://<staging-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Metadata only: no evidence storage adapter exists yet. Keep gate false.
OBJECT_STORAGE_ENDPOINT=https://<staging-project-ref>.supabase.co/storage/v1
OBJECT_STORAGE_BUCKET=<private-staging-evidence-bucket>
PARTNER_EVIDENCE_UPLOAD_APPROVED=false

# Owner must choose the hold value; placeholder does not open booking.
BOOKING_HOLD_MINUTES=<approved-hold-minutes>
BOOKING_API_APPROVED=false

# Mobile public compile-time values, documented here for cross-platform alignment.
# These are NOT server secrets and are NOT read by Website runtime.
# LAOSTRAVEL_BACKEND_URL=https://<staging-backend-host>
# LAOSTRAVEL_SUPABASE_URL=https://<staging-project-ref>.supabase.co
# LAOSTRAVEL_SUPABASE_PUBLISHABLE_KEY=<staging-publishable-key>
# LAOSTRAVEL_ENABLE_DEMO=false
